      }
    ],
    "requires": [
      {
        "id": "aeris-core",
        "type": "module"
      }
    ]
  },
"esmodules": [
    "dist/aeris-pf1e-sheet.js"
  ],
  "styles": [
    "dist/style.css"
  ]
}